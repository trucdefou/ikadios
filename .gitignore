*.pem
web-ext-artifacts/

# Python and Node leftovers
__pycache__/
*.pyc
node_modules/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Parser tests and their real game captures (local only, contain account data)
tests/
fixtures/
